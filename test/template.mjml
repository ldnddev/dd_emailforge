<mjml lang="en">
  <mj-head>
    <mj-title>You're in.</mj-title>
    <mj-preview>Here's what happens next.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-font name="Raleway" href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;700&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Raleway, Arial, Helvetica, sans-serif" />
      <mj-text color="#1a1a1a" font-size="16px" line-height="1.5" />
      <mj-button background-color="#FFAF46" color="#0F1114" border-radius="4px" inner-padding="12px 24px" font-weight="bold" />
      <mj-body background-color="#ffffff" width="600px" />
      <mj-section padding="20px 0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      .preheader { display:none !important; visibility:hidden; opacity:0; color:transparent; height:0; width:0; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff" width="600px">
    <mj-section css-class="preheader" padding="0">
      <mj-column>
        <mj-text>Here's what happens next.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column width="100%">
        <mj-table font-size="14px" font-family="Arial" color="#000000" align="left" width="100%" border="1px solid #000000" padding="2%" cellpadding="1" cellspacing="2" role="none" css-class="table-class">
          <tr><td>this is a table entry inside a column.</td></tr>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-divider />
        <mj-text font-size="12px" align="center" color="#1a1a1a">
          Example Co<br />123 Main St<br />Springfield, IL 62701<br /><a href="*|UNSUB|*">Unsubscribe</a><br />© Example Co
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column width="100%">
        <mj-table>
          <tr><td></td></tr>
        </mj-table>
        <mj-button href="https://example.com" background-color="#101010" color="#ffffff" align="center" font-family="Arial" font-size="22px" font-weight="bold" font-style="normal" border="1px solid #ff0000" border-radius="12px" inner-padding="12px" target="_blank" padding="4px" line-height="100%" text-decoration="underline" text-transform="uppercase">
          Read more
        </mj-button>
      </mj-column>
      <mj-group>
        <mj-column>
          <mj-text>
            Write something.
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-wrapper>
    </mj-wrapper>
  </mj-body>
</mjml>
